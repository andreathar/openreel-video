{"id": "parenthetical-context-a", "pair_id": "parenthetical-context", "pair_number": 9, "variant": "A", "title": "Parenthetical in and out of dialogue", "category": "parenthetical", "fountain": "(under her breath)", "expected_types": ["Action"], "supported_by_demo": true, "rationale": "Parentheses do not independently determine the screenplay element; preceding dialogue context does.", "reference": "https://fountain.io/syntax/", "provenance": "Original Inkwell teaching fixture", "license": "CC0-1.0", "split_group": "parenthetical-context"}
