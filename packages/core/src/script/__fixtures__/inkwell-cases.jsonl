{"id": "parenthetical-inline-a", "pair_id": "parenthetical-inline", "pair_number": 10, "variant": "A", "title": "Extension versus direction", "category": "parenthetical", "fountain": "LENA (on radio)\nCheck again.", "expected_types": ["Character", "Dialogue"], "supported_by_demo": true, "rationale": "The two encodings place direction differently. Do not silently merge them in an interchange test.", "reference": "https://fountain.io/syntax/", "provenance": "Original Inkwell teaching fixture", "license": "CC0-1.0", "split_group": "parenthetical-inline"}
{"id": "parenthetical-inline-b", "pair_id": "parenthetical-inline", "pair_number": 10, "variant": "B", "title": "Extension versus direction", "category": "parenthetical", "fountain": "LENA\n(on radio)\nCheck again.", "expected_types": ["Character", "Parenthetical", "Dialogue"], "supported_by_demo": true, "rationale": "The two encodings place direction differently. Do not silently merge them in an interchange test.", "reference": "https://fountain.io/syntax/", "provenance": "Original Inkwell teaching fixture", "license": "CC0-1.0", "split_group": "parenthetical-inline"}
{"id": "two-dialogue-lines-a", "pair_id": "two-dialogue-lines", "pair_number": 11, "variant": "A", "title": "Hard breaks do not add speakers", "category": "whitespace", "fountain": "LENA\nOne key. One chance.", "expected_types": ["Character", "Dialogue"], "supported_by_demo": true, "rationale": "A line break changes line count without changing the speaker. Line share is not word share.", "reference": "https://fountain.io/syntax/", "provenance": "Original Inkwell teaching fixture", "license": "CC0-1.0", "split_group": "two-dialogue-lines"}
