{"id": "numeric-cue-a", "pair_id": "numeric-cue", "pair_number": 7, "variant": "A", "title": "At least one letter", "category": "character", "fountain": "23\nTry the west door.", "expected_types": ["Action", "Action"], "supported_by_demo": true, "rationale": "An all-digit line is not automatically a character cue. A letter changes the syntactic candidate.", "reference": "https://fountain.io/syntax/", "provenance": "Original Inkwell teaching fixture", "license": "CC0-1.0", "split_group": "numeric-cue"}
