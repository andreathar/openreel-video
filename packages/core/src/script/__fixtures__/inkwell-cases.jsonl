{"id": "two-action-lines-a", "pair_id": "two-action-lines", "pair_number": 12, "variant": "A", "title": "A line break is not a new scene", "category": "whitespace", "fountain": "The clock stops. The room stays bright.", "expected_types": ["Action"], "supported_by_demo": true, "rationale": "Wrapping action changes line-level statistics while leaving words and scenes unchanged.", "reference": "https://fountain.io/syntax/", "provenance": "Original Inkwell teaching fixture", "license": "CC0-1.0", "split_group": "two-action-lines"}
