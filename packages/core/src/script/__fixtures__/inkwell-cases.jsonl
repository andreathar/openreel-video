{"id": "boneyard-a", "pair_id": "boneyard", "pair_number": 21, "variant": "A", "title": "Omitted text is not visible content", "category": "unsupported", "fountain": "The ticket is blank.", "expected_types": ["Action"], "supported_by_demo": true, "rationale": "Boneyarded material should not enter visible-text metrics. This educational exporter refuses it instead of stripping potentially meaningful text.", "reference": "https://fountain.io/syntax/", "provenance": "Original Inkwell teaching fixture", "license": "CC0-1.0", "split_group": "boneyard"}
{"id": "boneyard-b", "pair_id": "boneyard", "pair_number": 21, "variant": "B", "title": "Omitted text is not visible content", "category": "unsupported", "fountain": "/*The ticket is blank.*/", "expected_types": [], "supported_by_demo": false, "rationale": "Boneyarded material should not enter visible-text metrics. This educational exporter refuses it instead of stripping potentially meaningful text.", "reference": "https://fountain.io/syntax/", "provenance": "Original Inkwell teaching fixture", "license": "CC0-1.0", "split_group": "boneyard"}
{"id": "section-a", "pair_id": "section", "pair_number": 22, "variant": "A", "title": "Outline structure is not a scene", "category": "unsupported", "fountain": "ARRIVAL", "expected_types": ["Action"], "supported_by_demo": true, "rationale": "A section heading belongs to outline metadata. It is not a screenplay scene heading or a filmed action.", "reference": "https://fountain.io/syntax/", "provenance": "Original Inkwell teaching fixture", "license": "CC0-1.0", "split_group": "section"}
