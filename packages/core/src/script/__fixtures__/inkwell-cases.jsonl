{"id": "voice-extension-a", "pair_id": "voice-extension", "pair_number": 8, "variant": "A", "title": "A cue extension is not a second speaker", "category": "character", "fountain": "LENA\nThe lift is stuck.", "expected_types": ["Character", "Dialogue"], "supported_by_demo": true, "rationale": "The extension affects delivery, not a demonstrated character-identity change.", "reference": "https://fountain.io/syntax/", "provenance": "Original Inkwell teaching fixture", "license": "CC0-1.0", "split_group": "voice-extension"}
