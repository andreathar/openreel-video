{"id": "forced-scene-a", "pair_id": "forced-scene", "pair_number": 6, "variant": "A", "title": "A heading without INT or EXT", "category": "scene", "fountain": "THE FOLLOWING MORNING", "expected_types": ["Action"], "supported_by_demo": true, "rationale": "A leading period forces a scene heading. It does not prove a new physical location.", "reference": "https://fountain.io/syntax/", "provenance": "Original Inkwell teaching fixture", "license": "CC0-1.0", "split_group": "forced-scene"}
