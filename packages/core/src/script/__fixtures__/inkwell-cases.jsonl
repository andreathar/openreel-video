{"id": "automatic-transition-a", "pair_id": "automatic-transition", "pair_number": 13, "variant": "A", "title": "A transition needs its own paragraph", "category": "transition", "fountain": "CUT TO:\n\nEXT. PLATFORM - DAWN", "expected_types": ["Transition", "Scene Heading"], "supported_by_demo": true, "rationale": "A missing blank line can create a different parse. This laboratory illustrates the reference subset, not a repair policy for arbitrary files.", "reference": "https://fountain.io/syntax/", "provenance": "Original Inkwell teaching fixture", "license": "CC0-1.0", "split_group": "automatic-transition"}
{"id": "automatic-transition-b", "pair_id": "automatic-transition", "pair_number": 13, "variant": "B", "title": "A transition needs its own paragraph", "category": "transition", "fountain": "CUT TO:\nEXT. PLATFORM - DAWN", "expected_types": ["Character", "Dialogue"], "supported_by_demo": true, "rationale": "A missing blank line can create a different parse. This laboratory illustrates the reference subset, not a repair policy for arbitrary files.", "reference": "https://fountain.io/syntax/", "provenance": "Original Inkwell teaching fixture", "license": "CC0-1.0", "split_group": "automatic-transition"}
