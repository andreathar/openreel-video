{"id": "note-a", "pair_id": "note", "pair_number": 20, "variant": "A", "title": "Annotation is not screenplay action", "category": "unsupported", "fountain": "The ticket is blank.", "expected_types": ["Action"], "supported_by_demo": true, "rationale": "Bracket notes require a dedicated nonprinting representation. The subset parser rejects notes rather than counting them as spoken or visible action.", "reference": "https://fountain.io/syntax/", "provenance": "Original Inkwell teaching fixture", "license": "CC0-1.0", "split_group": "note"}
