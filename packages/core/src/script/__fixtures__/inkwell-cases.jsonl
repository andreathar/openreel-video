{"id": "literal-forcing-a", "pair_id": "literal-forcing", "pair_number": 18, "variant": "A", "title": "Explicit action before a heading-like line", "category": "scene", "fountain": "INT. THE LETTER SAYS NOTHING - DAY", "expected_types": ["Scene Heading"], "supported_by_demo": true, "rationale": "A forcing marker overrides an apparent scene prefix. A converter must preserve the intended element.", "reference": "https://fountain.io/syntax/", "provenance": "Original Inkwell teaching fixture", "license": "CC0-1.0", "split_group": "literal-forcing"}
