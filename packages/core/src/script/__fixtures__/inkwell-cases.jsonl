{"id": "blank-before-cue-a", "pair_id": "blank-before-cue", "pair_number": 4, "variant": "A", "title": "A cue needs a boundary", "category": "whitespace", "fountain": "A drawer opens.\nROWAN\nThat is the last one.", "expected_types": ["Action", "Action", "Action"], "supported_by_demo": true, "rationale": "A paragraph boundary matters; capitalization alone is not a sufficient detector.", "reference": "https://fountain.io/syntax/", "provenance": "Original Inkwell teaching fixture", "license": "CC0-1.0", "split_group": "blank-before-cue"}
