{"id": "dual-dialogue-a", "pair_id": "dual-dialogue", "pair_number": 19, "variant": "A", "title": "Simultaneity needs a structure", "category": "unsupported", "fountain": "LENA\nWait.\n\nROWAN\nGo.", "expected_types": ["Character", "Dialogue", "Character", "Dialogue"], "supported_by_demo": true, "rationale": "The caret signals simultaneous delivery. The simple FDX exporter refuses this case because sibling paragraphs alone do not preserve dual dialogue.", "reference": "https://fountain.io/syntax/", "provenance": "Original Inkwell teaching fixture", "license": "CC0-1.0", "split_group": "dual-dialogue"}
